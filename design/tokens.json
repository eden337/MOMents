{
  "$description": "MOMents design tokens — source of truth shared by Figma variables and the app theme. Colors are hex; dimensions are dp/px. Semantic colors reference primitives as {primitive.name}.",
  "$version": "0.1.0",
  "primitives": {
    "color": {
      "white": "#FFFFFF",
      "black": "#000000",
      "cream/50": "#FFF8F0",
      "peach/100": "#FFEBDD",
      "peach/200": "#FFD9C0",
      "peach/800": "#8C4A1F",
      "peach/950": "#3A2A22",
      "blue/200": "#A9D6E5",
      "blue/300": "#8CC8DC",
      "blue/700": "#2C6E85",
      "blue/900": "#1E3A44",
      "coral/100": "#FFE3E1",
      "coral/300": "#FF8A8A",
      "coral/400": "#FF6B6B",
      "coral/600": "#C93C3C",
      "coral/700": "#B83232",
      "coral/950": "#3F2122",
      "mint/200": "#A8E6CF",
      "mint/300": "#8FDDBF",
      "mint/700": "#2B7058",
      "mint/900": "#1D3B30",
      "amber/300": "#F5C26B",
      "amber/700": "#9A5B00",
      "neutral/100": "#F3EEE8",
      "neutral/200": "#E7E2DC",
      "neutral/400": "#9CA3AF",
      "neutral/500": "#8A919C",
      "neutral/600": "#5F6672",
      "neutral/900": "#333333",
      "night/text": "#F5EFE8",
      "night/text-2": "#B8B2AB",
      "night/500": "#7A746E",
      "night/700": "#3D3835",
      "night/800": "#2F2B29",
      "night/900": "#262321",
      "night/950": "#1C1A19"
    }
  },
  "semantic": {
    "color": {
      "bg/canvas":              { "light": "{cream/50}",   "dark": "{night/950}" },
      "bg/surface":             { "light": "{white}",      "dark": "{night/900}" },
      "bg/surface-raised":      { "light": "{white}",      "dark": "{night/800}" },
      "bg/subtle":              { "light": "{neutral/100}","dark": "{night/800}" },
      "bg/brand-peach":         { "light": "{peach/200}",  "dark": "{peach/950}" },
      "bg/brand-blue":          { "light": "{blue/200}",   "dark": "{blue/900}" },
      "bg/brand-mint":          { "light": "{mint/200}",   "dark": "{mint/900}" },
      "bg/accent-subtle":       { "light": "{coral/100}",  "dark": "{coral/950}" },
      "action/primary":         { "light": "{coral/600}",  "dark": "{coral/300}" },
      "action/primary-pressed": { "light": "{coral/700}",  "dark": "{coral/400}" },
      "action/on-primary":      { "light": "{white}",      "dark": "{night/950}" },
      "action/secondary":       { "light": "{blue/200}",   "dark": "{blue/900}" },
      "action/on-secondary":    { "light": "{neutral/900}","dark": "{night/text}" },
      "text/primary":           { "light": "{neutral/900}","dark": "{night/text}" },
      "text/secondary":         { "light": "{neutral/600}","dark": "{night/text-2}" },
      "text/disabled":          { "light": "{neutral/400}","dark": "{night/500}" },
      "text/accent":            { "light": "{coral/700}",  "dark": "{coral/300}" },
      "text/link":              { "light": "{blue/700}",   "dark": "{blue/300}" },
      "text/on-brand":          { "light": "{neutral/900}","dark": "{night/text}" },
      "icon/default":           { "light": "{neutral/900}","dark": "{night/text}" },
      "icon/muted":             { "light": "{neutral/600}","dark": "{night/text-2}" },
      "icon/accent":            { "light": "{coral/600}",  "dark": "{coral/300}" },
      "border/subtle":          { "light": "{neutral/200}","dark": "{night/700}" },
      "border/strong":          { "light": "{neutral/500}","dark": "{night/500}" },
      "border/focus":           { "light": "{blue/700}",   "dark": "{blue/300}" },
      "status/success":         { "light": "{mint/700}",   "dark": "{mint/300}" },
      "status/error":           { "light": "{coral/700}",  "dark": "{coral/300}" },
      "status/warning":         { "light": "{amber/700}",  "dark": "{amber/300}" },
      "status/info":            { "light": "{blue/700}",   "dark": "{blue/300}" }
    }
  },
  "dimension": {
    "spacing/0": 0,
    "spacing/0-5": 2,
    "spacing/1": 4,
    "spacing/2": 8,
    "spacing/3": 12,
    "spacing/4": 16,
    "spacing/5": 20,
    "spacing/6": 24,
    "spacing/8": 32,
    "spacing/10": 40,
    "spacing/12": 48,
    "spacing/16": 64,
    "radius/none": 0,
    "radius/sm": 8,
    "radius/md": 12,
    "radius/lg": 16,
    "radius/xl": 24,
    "radius/full": 999,
    "size/touch-target": 48,
    "size/icon-sm": 16,
    "size/icon-md": 20,
    "size/icon-lg": 24
  },
  "typography": {
    "$fontFamily": "Rubik (Hebrew + Latin). Fallbacks: Heebo, Assistant.",
    "display":   { "size": 32, "lineHeight": 40, "weight": "Bold" },
    "title-1":   { "size": 26, "lineHeight": 34, "weight": "SemiBold" },
    "title-2":   { "size": 22, "lineHeight": 28, "weight": "SemiBold" },
    "title-3":   { "size": 18, "lineHeight": 24, "weight": "SemiBold" },
    "body-lg":   { "size": 17, "lineHeight": 26, "weight": "Regular" },
    "body":      { "size": 16, "lineHeight": 24, "weight": "Regular" },
    "body-strong": { "size": 16, "lineHeight": 24, "weight": "Medium" },
    "body-sm":   { "size": 14, "lineHeight": 20, "weight": "Regular" },
    "label":     { "size": 14, "lineHeight": 20, "weight": "Medium" },
    "caption":   { "size": 12, "lineHeight": 16, "weight": "Regular" }
  },
  "effect": {
    "shadow/card":  { "y": 2, "blur": 12, "spread": 0, "color": "#333333", "opacity": 0.08 },
    "shadow/sheet": { "y": -4, "blur": 24, "spread": 0, "color": "#333333", "opacity": 0.12 }
  }
}
